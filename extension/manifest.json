{
  "manifest_version": 3,
  "name": "Bini Voice — Voice Changer",
  "short_name": "Bini Voice",
  "version": "1.0.0",
  "description": "Change your microphone voice on any website — male, female, every age, characters and your own custom voices.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bini Voice",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "options_page": "studio/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/dsp.js", "lib/presets.js", "lib/engine.js", "inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["lib/worklet.js"], "matches": ["<all_urls>"] }
  ]
}
